PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?entity
WHERE {
  ?entity a owl:Class .
  FILTER(STRSTARTS(STR(?entity), "http://www.opengroup.org/ontology/archimate/"))
  FILTER NOT EXISTS { ?entity rdfs:subClassOf ?super . }
  FILTER NOT EXISTS { ?child rdfs:subClassOf ?entity . }
  FILTER (?entity != owl:Thing)
}
