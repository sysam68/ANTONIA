PREFIX owl: <http://www.w3.org/2002/07/owl#>

# Source-scope rule executed by toolbox/reason.sh before any merge.
# The configured MAPPINGS ontology is deliberately excluded from this check.

SELECT DISTINCT ?entity ?property ?value
WHERE {
  ?entity owl:equivalentClass ?value .
  BIND(owl:equivalentClass AS ?property)
}
ORDER BY ?entity ?value
