# Ontology files
TBOX=src/edit/myOntology-tbox.rdf
ABOX=src/edit/myOntology-abox.rdf
MAPPINGS=  # only source allowed to declare class equivalences
OBDA=src/edit/myOntology-tbox.obda
ONTOP_PROPERTIES=src/edit/myOntology.properties
CATALOG=src/edit/catalog-v001.xml
QL_PROJECTION_UPDATE=src/sparql/updates/project-ql.ru

# Quality Check Files
PROFILE=qc/profile.txt
ALLOWLIST=qc/allowlist.tsv
EXPECTED=qc/obo-expected.tsv
FAIL_ON=ERROR     # seuil de sévérité (NONE|INFO|WARN|ERROR)
QC_STRICT=1       # 1 = bloque, 0 = n’arrête pas le build

# Base IRIs
BASE_IRI=https://example.org/ontology/myOntology/
INSTANCE_BASE_IRI=https://example.org/id/myOntology/

# Paths
IMPORTS_DIR=src/edit/imports
MAPPINGS_DIR=src/edit/mappings
SERVICES_DIR=src/edit/services
MODULES_DIR=src/edit/modules
ANNOTATIONS_DIR=src/edit/annotations
TEMPLATE_DIRS=src/edit/templates,src/edit/templates/instances,src/edit/annotations
SHAPES_DIR=src/shapes
SPARQL_CHECKS=src/sparql/checks    # ROBOT report queries: ?entity ?property ?value
SPARQL_REPORTS=src/sparql/reports  # non-blocking analytics only
ONTOLOGY_DESIGN_RECORD=docs/ontology-design.md
TARGET=tmp
RELEASES=releases
OUTPUT_FORMAT=rdf  # rdf|ttl|owl

# Build settings
REASONER=HERMIT
REFERENCE_PROFILE=DL
ONTOP_PROFILE=QL
ONTOLOGY_NAME=my-ontology
JAVA_CONF=config/java.conf

# Interactive semantic authoring
ONTOGPT_MODEL=
ONTOGPT_ALLOW_EXTERNAL_LLM=0
DB_SAMPLE_ROWS=20
DB_SAMPLE_TABLES=
DB_SAMPLE_TO_LLM=0
SHACL_FAIL_ON=VIOLATION

# Git settings
GIT_MAIN_BRANCH=main
GIT_DEV_BRANCH=dev
RELEASE_TAG_PREFIX=my-v
USE_GH=1
GH_CREATE_RELEASE=1
GH_RELEASE_DRAFT=0
GH_RELEASE_PRERELEASE=0
GH_RELEASE_NOTES_FILE=
