###  http://www.opengroup.org/ontology/archimate#Service
:Service rdf:type owl:Class ;
         rdfs:subClassOf :ExternalBehaviourElement ;
         rdfs:label "A service"@en ;
         <http://www.w3.org/2004/02/skos/core#definition> "is an explicitly defined exposed behavior."@en .


###  http://www.opengroup.org/ontology/archimate#Stakeholder
:Stakeholder rdf:type owl:Class ;
             rdfs:subClassOf :ActiveStructureElement ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty :influence ;
                               owl:someValuesFrom :Stakeholder
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty :isLayeredIn ;
                               owl:someValuesFrom :MotivationLayer
                             ] ;
             rdfs:isDefinedBy <https://bp4mc2.org/def/archimate#Stakeholder> ;
             rdfs:label "A stakeholder"@en ;
             <http://www.w3.org/2004/02/skos/core#definition> "is the role of an individual, team, or organization (or classes thereof) that represents their interests in the outcome of the architecture."@en .


###  http://www.opengroup.org/ontology/archimate#StrategicLayer
:StrategicLayer rdf:type owl:Class ;
                rdfs:subClassOf :Layer ;
                rdfs:label "The Strategic Layer"@en ;
                <http://www.w3.org/2004/02/skos/core#definition> "represents the highest conceptual layer within the enterprise architecture landscape. It provides constructs to model strategic intent and planning, bridging business objectives and actionable architecture elements."@en .


###  http://www.opengroup.org/ontology/archimate#StrategyBehaviourElement
:StrategyBehaviourElement rdf:type owl:Class ;
                          rdfs:subClassOf :BehaviorElement ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty :Triggering ;
                                            owl:someValuesFrom :StrategyBehaviourElement
