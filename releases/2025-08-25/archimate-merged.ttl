###  http://www.opengroup.org/ontology/archimate#Resource
:Resource rdf:type owl:Class ;
          rdfs:subClassOf :StructureElement ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :assignment ;
                            owl:someValuesFrom :Capability
                          ] ;
