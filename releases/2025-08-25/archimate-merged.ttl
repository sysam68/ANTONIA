                                   owl:onProperty :composition ;
                                   owl:someValuesFrom :TechnologyFunction
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty :composition ;
                                   owl:someValuesFrom :TechnologyInteraction
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty :composition ;
                                   owl:someValuesFrom :TechnologyInterface
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty :composition ;
                                   owl:someValuesFrom :TechnologyObject
                                 ] ,
                                 [ rdf:type owl:Restriction ;
