                           owl:someValuesFrom :DataObject
                         ] ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :composition ;
                           owl:someValuesFrom :TechnologyService
                         ] ,
                         [ rdf:type owl:Restriction ;
